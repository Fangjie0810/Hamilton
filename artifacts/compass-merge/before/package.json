{
  "name": "project-hamilton-1776",
  "version": "0.4.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1776 --strictPort",
    "prebuild": "python3 scripts/releases.py stamp",
    "build": "npm run check:i18n && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1776 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:i18n": "node --import tsx scripts/check-i18n.ts",
    "test:releases": "python3 -m unittest discover -s tests/releases -v",
    "release:pack": "python3 scripts/releases.py pack"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.185.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
